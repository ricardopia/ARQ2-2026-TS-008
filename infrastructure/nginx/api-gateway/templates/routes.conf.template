# Correlation id: reuse the client's when provided, otherwise generate one
# (spec section 3.1).
map $http_x_correlation_id $correlation_id {
    default $http_x_correlation_id;
    ""      $request_id;
}

log_format correlated escape=json
    '$time_local client=$remote_addr request="$request" '
    'status=$status correlation_id=$correlation_id request_time=$request_time';

# --- Public endpoints (no access token, spec FR-1.1) -----------------------
# --- Every other /api/v1/ request is checked by auth_request before ---------
# --- it is proxied to Core API ----------------------------------------------

server {
    listen 8080;
    server_name _;

    access_log /var/log/nginx/access.log correlated;

    # Present on every response, including errors generated by this gateway.
    add_header X-Correlation-Id $correlation_id always;

    location = /api/v1/auth/register {
        proxy_pass http://core-api:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Correlation-Id $correlation_id;
        proxy_hide_header X-Correlation-Id;
        client_max_body_size 1m;
    }

    location = /api/v1/auth/login {
        proxy_pass http://core-api:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Correlation-Id $correlation_id;
        proxy_hide_header X-Correlation-Id;
        client_max_body_size 1m;
    }

    # Protected API traffic: the request never reaches Core API without a
    # valid token (FR-1.1).
    location /api/v1/ {
        auth_request /_auth_check;
        error_page 401 = @unauthenticated;
        error_page 413 = @payload_too_large;

        proxy_pass http://core-api:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Correlation-Id $correlation_id;
        proxy_hide_header X-Correlation-Id;

        # Spec FR-4.2: bodies larger than 1 MiB never reach Core API.
        client_max_body_size 1m;
    }

    # WebSocket traffic authenticates with a one-time ticket, not a JWT
    # (spec section 3.5).
    #
    # NOTE: re-enable when the realtime-service container exists; nginx fails
    # to start while the upstream host does not resolve.
    #
    # location /ws {
    #     proxy_pass http://realtime-service:3000;
    #     proxy_http_version 1.1;
    #     proxy_set_header Upgrade $http_upgrade;
    #     proxy_set_header Connection "upgrade";
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Correlation-Id $correlation_id;
    # }

    # Only this server block calls Core API's internal endpoints; no client
    # location proxies /internal/* (NFR-5).
    location = /_auth_check {
        internal;
        proxy_pass http://core-api:8080/internal/auth/introspect;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header X-Internal-Token ${INTERNAL_TOKEN};
        proxy_set_header X-Correlation-Id $correlation_id;
    }

    location @unauthenticated {
        default_type application/problem+json;
        return 401 '{"type":"/problems/unauthenticated","title":"Unauthenticated","status":401,"code":"UNAUTHENTICATED","detail":"A valid access token is required.","instance":"$request_uri","correlationId":"$correlation_id"}';
    }

    location @payload_too_large {
        default_type application/problem+json;
        return 413 '{"type":"/problems/payload-too-large","title":"Payload too large","status":413,"code":"PAYLOAD_TOO_LARGE","detail":"The request body exceeds the 1 MiB limit.","instance":"$request_uri","correlationId":"$correlation_id"}';
    }

    location /health {
        default_type application/json;
        return 200 '{"status":"healthy"}';
    }
}
